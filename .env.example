# Copy to .env and fill in. Never commit .env.

# Telegram alerts (optional; without these, signals print to the console)
# 1. Talk to @BotFather on Telegram, send /newbot, copy the token it gives you.
# 2. Send your new bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
SOLSCOUT_TELEGRAM_TOKEN=
SOLSCOUT_TELEGRAM_CHAT_ID=

# Solana RPC (strongly recommended). The public node rate-limits (HTTP 429) and the bot then falls back to RugCheck.
# Get a free key at https://www.helius.dev and paste the full URL it gives you, e.g.
# SOLSCOUT_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Dashboard (python3 -m solscout serve). Set a password before exposing it beyond your own computer.
# SOLSCOUT_DASHBOARD_PASSWORD=
# SOLSCOUT_HOST=127.0.0.1
# SOLSCOUT_PORT=8080

# Tuning (defaults shown)
# SOLSCOUT_SIGNAL_THRESHOLD=70
# SOLSCOUT_MIN_LIQUIDITY_USD=15000
# SOLSCOUT_SCAN_INTERVAL_S=60
# SOLSCOUT_MAX_SIGNALS_PER_DAY=10
