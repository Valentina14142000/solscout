# Copy to .env and fill in. Never commit .env.

# Telegram alerts (optional; without these, signals print to the console)
# 1. Talk to @BotFather on Telegram, send /newbot, copy the token it gives you.
# 2. Send your new bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
SOLSCOUT_TELEGRAM_TOKEN=
SOLSCOUT_TELEGRAM_CHAT_ID=

# Solana RPC (optional). The public node is rate limited; a free Helius or QuickNode URL works better.
# SOLSCOUT_RPC_URL=

# Tuning (defaults shown)
# SOLSCOUT_SIGNAL_THRESHOLD=70
# SOLSCOUT_MIN_LIQUIDITY_USD=15000
# SOLSCOUT_SCAN_INTERVAL_S=60
# SOLSCOUT_MAX_SIGNALS_PER_DAY=10
